# /etc =========================

etc/profile = {
export TERM=qansi
export PATH=/proc/boot:/system/xbin
export LD_LIBRARY_PATH=/proc/boot:/system/lib:/system/lib/dll
# local/snippets/profile.custom
# Contents are included at the end of /etc/profile
}

[gid=0 uid=0 perms=644] /etc/syslog.conf = {
# Note need a tab to separate fields
*.*	/dev/console
}

[uid=0 gid=0 dperms=755 perms=555]

[perms=0555] xbin/start_net.sh=output/build/start_net.sh

