usr/lib/libqcrypto.so
lib/dll/qcrypto-openssl.so
lib/libqh.so.1
lib/libregex.so.1
#if defined(OPT_CERTICOM_yes)
lib/dll/qcrypto-certicom.so
lib/libhuapi.so
lib/libsbgse.so
lib/libtp.so
#endif
#if defined(OPT_TOMCRYPT_yes)
lib/dll/qcrypto-tomcrypt.so
#endif

[uid=0 gid=0 perms=0444] qcrypto.conf={
#if defined(OPT_TOMCRYPT_yes)
tomcrypt tags=*
#endif
#if defined(OPT_CERTICOM_yes)
certicom tags=*
#endif
openssl tags=*
}
